let swStart=0,swTimer=null,swElapsed=0;
function renderSW(){
  let x=swElapsed+(swStart?Date.now()-swStart:0);
  x=Math.floor(x/1000);document.getElementById("stopwatch").textContent=
  [Math.floor(x/3600),Math.floor(x/60)%60,x%60].map(n=>String(n).padStart(2,"0")).join(":");
}
function startStopwatch(){if(!swStart){swStart=Date.now();swTimer=setInterval(renderSW,250)}}
function stopStopwatch(){if(swStart){swElapsed+=Date.now()-swStart;swStart=0;clearInterval(swTimer);renderSW()}}
function resetStopwatch(){stopStopwatch();swElapsed=0;renderSW()}
let timerInt=null;
function startTimer(){
  clearInterval(timerInt);let s=+document.getElementById("timerInput").value||0;
  const out=document.getElementById("timerDisplay");
  timerInt=setInterval(()=>{out.textContent="00:"+String(s).padStart(2,"0");if(--s<0){clearInterval(timerInt);out.textContent="00:00";toast("Timer finished 🔔")}},1000);
}

