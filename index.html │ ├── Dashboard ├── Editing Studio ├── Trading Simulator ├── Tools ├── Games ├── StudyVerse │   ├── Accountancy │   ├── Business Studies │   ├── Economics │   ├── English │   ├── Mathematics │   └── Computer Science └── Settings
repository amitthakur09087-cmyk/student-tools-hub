function exportProject(){
  if(currentMedia && currentMedia.file.type.startsWith("image/")){
    const a=document.createElement("a");a.href=currentMedia.url;a.download="editverse-image."+currentMedia.file.name.split(".").pop();a.click();
    toast("Image exported");
  }else{
    const data=`EditVerse Project\nMedia: ${clips.length}\nText: ${document.getElementById("textInput").value}`;
    const blob=new Blob([data],{type:"text/plain"});
    const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="EditVerse_Project.txt";a.click();
    toast("Project summary exported");
  }
