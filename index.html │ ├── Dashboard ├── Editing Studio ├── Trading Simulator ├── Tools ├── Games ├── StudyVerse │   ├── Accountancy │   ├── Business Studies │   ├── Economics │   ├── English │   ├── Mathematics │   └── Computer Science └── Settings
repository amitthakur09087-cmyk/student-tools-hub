function ageCalc(){
  const d=new Date(document.getElementById("birthDate").value);
  if(isNaN(d))return;
  const n=new Date();
  let age=n.getFullYear()-d.getFullYear();
  const m=n.getMonth()-d.getMonth();
  if(m<0||(m===0&&n.getDate()<d.getDate()))age--;
  document.getElementById("ageResult").textContent=age+" years";
}
