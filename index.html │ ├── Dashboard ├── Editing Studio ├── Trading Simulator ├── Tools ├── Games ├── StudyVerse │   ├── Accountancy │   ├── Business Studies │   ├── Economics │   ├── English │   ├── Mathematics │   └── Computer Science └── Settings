/* =========================
   TRADING SIMULATOR
========================= */
const assets={
 NEON:{name:"NEON TECH",price:250},
 PIXEL:{name:"PIXEL MOTORS",price:180},
 CYBER:{name:"CYBER ENERGY",price:320}
};
let tradeState=JSON.parse(localStorage.getItem("editverseTrade")||"null")||{
 cash:100000,positions:{},history:[],start:100000
};
function money(n){return "₹"+Number(n).toLocaleString("en-IN",{maximumFractionDigits:2})}
function selectedAsset(){return document.getElementById("tradeSymbol").value}
function refreshTrading(){
  const sym=selectedAsset();
  document.getElementById("stockName").textContent=assets[sym].name;
  document.getElementById("price").textContent=money(assets[sym].price);
  document.getElementById("balance").textContent=money(tradeState.cash);
  document.getElementById("dashBalance").textContent=money(tradeState.cash);

  let pv=tradeState.cash;
  let html="";
  for(const [s,q] of Object.entries(tradeState.positions)){
    const val=q*assets[s].price;pv+=val;
    html+=`<div class="row" style="justify-content:space-between;padding:8px 0;border-bottom:1px solid #222632">
      <span>${assets[s].name} × ${q}</span><b>${money(val)}</b></div>`;
  }
  document.getElementById("portfolioValue").textContent=money(pv);
  document.getElementById("pnl").textContent=money(pv-tradeState.start);
  document.getElementById("portfolioList").innerHTML=html||"No positions yet.";
  document.getElementById("tradeHistory").innerHTML=tradeState.history.length?
    tradeState.history.slice().reverse().map(t=>`<tr><td>${t.time}</td><td>${t.action}</td><td>${assets[t.sym].name}</td><td>${t.qty}</td><td>${money(t.price)}</td><td>${money(t.total)}</td></tr>`).join(""):
    `<tr><td colspan="6" class="muted">No trades yet.</td></tr>`;
}
document.getElementById("tradeSymbol").addEventListener("change",refreshTrading);

function trade(action){
  const sym=selectedAsset(),q=Math.max(1,parseInt(document.getElementById("tradeQty").value)||1);
  const p=assets[sym].price,total=p*q;
  tradeState.positions[sym]||=0;
  if(action==="buy"){
    if(tradeState.cash<total)return toast("Not enough virtual cash");
    tradeState.cash-=total;tradeState.positions[sym]+=q;
  }else{
    if(tradeState.positions[sym]<q)return toast("Not enough shares");
    tradeState.cash+=total;tradeState.positions[sym]-=q;
    if(!tradeState.positions[sym])delete tradeState.positions[sym];
  }
  tradeState.history.push({time:new Date().toLocaleTimeString(),action:action.toUpperCase(),sym,qty:q,price:p,total});
  localStorage.setItem("editverseTrade",JSON.stringify(tradeState));
  refreshTrading();toast(action.toUpperCase()+" order executed");
}
function marketTick(){
  Object.keys(assets).forEach(k=>{
    const change=(Math.random()-.5)*3.5;
    assets[k].price=Math.max(10,assets[k].price+change);
  });
  refreshTrading();drawTradingChart();
}
setInterval(marketTick,1600);

/* chart */
const tc=document.getElementById("tradingChart"),ctx=tc.getContext("2d");
let prices=Array.from({length:70},(_,i)=>250+Math.sin(i/5)*10+Math.random()*8);
function resizeCanvas(c){
  const r=c.getBoundingClientRect(),d=devicePixelRatio||1;
  c.width=r.width*d;c.height=r.height*d;
  c.getContext("2d").setTransform(d,0,0,d,0,0);
}
function drawTradingChart(){
  resizeCanvas(tc);
  const w=tc.clientWidth,h=tc.clientHeight;
  prices.push(assets.NEON.price);if(prices.length>70)prices.shift();
  ctx.clearRect(0,0,w,h);
  ctx.strokeStyle="#1b2430";ctx.lineWidth=1;
  for(let y=30;y<h;y+=45){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(w,y);ctx.stroke()}
  const min=Math.min(...prices)-5,max=Math.max(...prices)+5;
  ctx.beginPath();
  prices.forEach((p,i)=>{
    const x=i/(prices.length-1)*w,y=h-(p-min)/(max-min)*h;
    i?ctx.lineTo(x,y):ctx.moveTo(x,y);
  });
  ctx.strokeStyle="#00eaff";ctx.lineWidth=2;ctx.stroke();
}
window.addEventListener("resize",drawTradingChart);
setTimeout(()=>{refreshTrading();drawTradingChart()},100);

