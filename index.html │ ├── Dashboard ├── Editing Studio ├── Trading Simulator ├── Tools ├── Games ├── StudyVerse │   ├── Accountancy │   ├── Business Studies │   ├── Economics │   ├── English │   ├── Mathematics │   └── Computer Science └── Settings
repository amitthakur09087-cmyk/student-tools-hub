<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>EditVerse Mega Studio</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#050507;--panel:#0c0d12;--panel2:#11131a;--text:#f5f7ff;
  --muted:#8e94a8;--line:#202330;--cyan:#00eaff;--pink:#ff00a8;
  --purple:#8b5cff;--green:#00ff88;--yellow:#ffd000;
}
body{
  background:radial-gradient(circle at 20% 10%,#14102b 0,#050507 35%),
             radial-gradient(circle at 90% 80%,#081c26 0,#050507 35%);
  color:var(--text);font-family:Inter,Arial,sans-serif;min-height:100vh;
  overflow-x:hidden;
}
body:before{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:999;
  background:linear-gradient(115deg,transparent 0%,rgba(0,234,255,.025) 45%,transparent 55%);
  animation:scan 7s linear infinite;
}
@keyframes scan{0%{transform:translateX(-100%)}100%{transform:translateX(100%)}}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
.app{display:flex;min-height:100vh}
.sidebar{
  width:245px;position:fixed;left:0;top:0;bottom:0;z-index:50;
  background:rgba(7,8,12,.94);backdrop-filter:blur(18px);
  border-right:1px solid var(--line);padding:20px 14px;
  box-shadow:8px 0 40px rgba(0,234,255,.04);
}
.logo{
  font-size:24px;font-weight:900;letter-spacing:1px;padding:12px 10px 24px;
  text-shadow:0 0 10px var(--cyan),0 0 25px var(--pink);
}
.logo span{color:var(--cyan)}
.nav{display:flex;flex-direction:column;gap:7px}
.nav button{
  border:1px solid transparent;background:transparent;color:#aeb4c8;
  padding:12px 13px;border-radius:12px;text-align:left;transition:.2s;
}
.nav button:hover,.nav button.active{
  color:white;background:linear-gradient(90deg,rgba(0,234,255,.13),rgba(255,0,168,.08));
  border-color:#293040;box-shadow:0 0 18px rgba(0,234,255,.08);
}
.nav button.active{border-left:3px solid var(--cyan)}
.main{margin-left:245px;width:calc(100% - 245px);padding:24px}
.topbar{
  display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;
}
.search{
  width:min(420px,50%);background:#0d0f15;border:1px solid var(--line);
  border-radius:13px;padding:12px 15px;color:white;outline:none;
}
.search:focus{border-color:var(--cyan);box-shadow:0 0 15px rgba(0,234,255,.12)}
.rgb{
  height:2px;width:100%;position:fixed;top:0;left:0;z-index:100;
  background:linear-gradient(90deg,var(--pink),var(--purple),var(--cyan),var(--green),var(--yellow),var(--pink));
  background-size:300% 100%;animation:rgb 4s linear infinite;
  box-shadow:0 0 16px var(--cyan);
}
@keyframes rgb{to{background-position:300% 0}}
.page{display:none;animation:fade .25s ease}.page.active{display:block}
@keyframes fade{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}
h1{font-size:32px;margin-bottom:7px}
.subtitle{color:var(--muted);margin-bottom:22px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:15px}
.card{
  background:linear-gradient(145deg,rgba(17,19,26,.96),rgba(9,10,14,.96));
  border:1px solid var(--line);border-radius:18px;padding:20px;
  box-shadow:inset 0 1px rgba(255,255,255,.025),0 15px 35px rgba(0,0,0,.18);
}
.card:hover{border-color:#303746}
.stat{font-size:30px;font-weight:900;margin:8px 0}
.muted{color:var(--muted)}
.neon-btn{
  border:1px solid #303846;background:#10131a;color:white;border-radius:10px;
  padding:10px 14px;transition:.2s;
}
.neon-btn:hover{border-color:var(--cyan);box-shadow:0 0 18px rgba(0,234,255,.14);transform:translateY(-1px)}
.primary{background:linear-gradient(90deg,#007c91,#6d1c91);border-color:#00dfff}
.danger{border-color:#702044}.success{border-color:#176846}
.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
.small{font-size:13px}.tag{
  display:inline-block;border:1px solid #2b3040;border-radius:999px;padding:5px 9px;
  color:#bfc5d7;font-size:12px;margin:3px;
}

/* EDITOR */
.editor{
  background:#07080b;border:1px solid #252936;border-radius:18px;overflow:hidden;
  box-shadow:0 0 40px rgba(0,234,255,.05);
}
.editor-toolbar{
  min-height:60px;border-bottom:1px solid #20232d;padding:10px;display:flex;
  gap:7px;align-items:center;flex-wrap:wrap;background:#0a0b10;
}
.tool-btn{
  background:#11131a;color:#cbd0df;border:1px solid #252a37;border-radius:9px;
  padding:8px 11px;font-size:13px;
}
.tool-btn:hover{color:white;border-color:var(--cyan)}
.editor-workspace{display:grid;grid-template-columns:170px 1fr 220px;min-height:520px}
.media-panel,.properties{background:#0b0c11;padding:12px;border-right:1px solid #20232d}
.properties{border-right:0;border-left:1px solid #20232d}
.media-panel h3,.properties h3{font-size:13px;margin-bottom:12px;color:#c9cede}
.media-item{
  padding:12px;border:1px dashed #303544;border-radius:10px;margin-bottom:8px;
  text-align:center;color:#9299ad;font-size:12px;
}
.canvas-area{display:flex;align-items:center;justify-content:center;padding:25px;background:#050608}
.canvas{
  width:min(640px,100%);aspect-ratio:16/9;background:#111;
  border:1px solid #343846;position:relative;overflow:hidden;
  box-shadow:0 0 45px rgba(0,0,0,.5);
}
.canvas.vertical{aspect-ratio:9/16;width:min(330px,70%)}
.canvas.square{aspect-ratio:1;width:min(450px,80%)}
.canvas video,.canvas img{width:100%;height:100%;object-fit:contain}
.canvas-text{
  position:absolute;left:50%;top:45%;transform:translate(-50%,-50%);
  font-size:32px;font-weight:900;text-align:center;text-shadow:0 2px 8px black;
  display:none;white-space:nowrap;
}
.placeholder{text-align:center;color:#4c5263;padding-top:24%}
.prop{margin-bottom:15px}.prop label{font-size:11px;color:#81879a;display:block;margin-bottom:5px}
.prop input,.prop select{
  width:100%;background:#101219;border:1px solid #282d3a;color:white;
  padding:9px;border-radius:8px;outline:none;
}
.timeline{border-top:1px solid #20232d;background:#090a0e;padding:12px}
.track{
  height:58px;border:1px solid #242936;background:#0d0f15;border-radius:8px;
  margin-bottom:8px;position:relative;overflow:hidden;
}
.track-title{position:absolute;left:7px;top:5px;color:#666d7f;font-size:10px;z-index:2}
.clip{
  position:absolute;top:20px;height:30px;border-radius:6px;padding:7px;
  font-size:11px;background:linear-gradient(90deg,#094c59,#63275f);
  border:1px solid #00b8ce;min-width:100px;cursor:pointer;
}
.playhead{position:absolute;top:0;bottom:0;width:2px;background:#ff315f;left:10%;z-index:5;box-shadow:0 0 10px #ff315f}

/* TRADING */
.trading-grid{display:grid;grid-template-columns:1fr 300px;gap:15px}
.market{
  height:350px;background:#080a0f;border:1px solid #252936;border-radius:15px;
  position:relative;overflow:hidden;padding:15px;
}
canvas.chart{width:100%;height:280px}
.trade-box input,.trade-box select{
  width:100%;margin-bottom:10px;background:#0d1017;color:white;
  border:1px solid #292e3b;padding:10px;border-radius:8px;
}
.buy{background:#073b2a;border-color:#00a967}.sell{background:#461421;border-color:#bd3152}
.balance{font-size:26px;font-weight:900}
table{width:100%;border-collapse:collapse}
th,td{text-align:left;padding:11px;border-bottom:1px solid #222632;font-size:13px}
th{color:#777e92}

/* TOOLS */
.tool-card{min-height:155px}
.tool-card h3{margin-bottom:8px}
.tool-card input,.tool-card textarea,.tool-card select{
  width:100%;background:#0b0d12;color:white;border:1px solid #282d3b;
  padding:10px;border-radius:8px;margin:8px 0;outline:none;
}

/* NOTES */
.subject-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:15px}
.subject-tabs button{background:#10121a;color:#b8bfd1;border:1px solid #292e3b;padding:9px 12px;border-radius:9px}
.subject-tabs button.active{border-color:var(--cyan);color:white}
.chapter{
  background:#0d0f15;border:1px solid #252a36;border-radius:14px;margin-bottom:12px;overflow:hidden;
}
.chapter button{
  width:100%;background:none;border:0;color:white;padding:16px;text-align:left;font-weight:700;
}
.chapter-content{display:none;padding:0 16px 18px;color:#c1c6d4;line-height:1.7}
.chapter.open .chapter-content{display:block}
.chapter-content h4{color:#fff;margin:14px 0 6px}
.chapter-content ul{padding-left:22px}

/* GAMES */
.game{
  background:#08090d;border:1px solid #252a36;border-radius:15px;padding:14px;
}
.game canvas{width:100%;height:250px;background:#020304;border-radius:9px;display:block}
.game h3{margin-bottom:10px}

/* MODAL */
.modal{
  display:none;position:fixed;inset:0;background:rgba(0,0,0,.72);z-index:200;
  align-items:center;justify-content:center;padding:20px;
}
.modal.show{display:flex}
.modal-box{
  width:min(650px,100%);max-height:85vh;overflow:auto;background:#0d0f15;
  border:1px solid #303544;border-radius:18px;padding:20px;box-shadow:0 0 60px rgba(0,234,255,.12)
}
.close{float:right;background:none;color:white;border:0;font-size:22px}
.toast{
  position:fixed;right:20px;bottom:20px;background:#11151d;border:1px solid var(--cyan);
  padding:13px 17px;border-radius:10px;display:none;z-index:500;box-shadow:0 0 20px rgba(0,234,255,.18)
}
.toast.show{display:block}

/* MOBILE */
@media(max-width:1000px){
  .sidebar{width:72px;padding:15px 8px}.logo{font-size:0;text-align:center}
  .logo span{font-size:25px}.nav button{font-size:0;text-align:center}.nav button:first-letter{font-size:20px}
  .main{margin-left:72px;width:calc(100% - 72px)}
  .editor-workspace{grid-template-columns:1fr}.media-panel,.properties{display:none}
  .trading-grid{grid-template-columns:1fr}
}
@media(max-width:650px){
  .main{padding:14px}.topbar{gap:10px}.search{width:55%}h1{font-size:25px}
}
</style>
</head>

<body>
<div class="rgb"></div>

<div class="app">
<aside class="sidebar">
  <div class="logo">EDIT<span>VERSE</span></div>
  <div class="nav">
    <button class="active" data-page="home">🏠 Dashboard</button>
    <button data-page="editor">🎬 Editing Studio</button>
    <button data-page="trading">📈 Demo Trading</button>
    <button data-page="tools">🧰 Tools</button>
    <button data-page="games">🎮 Games</button>
    <button data-page="notes">📚 StudyVerse</button>
    <button data-page="settings">⚙️ Settings</button>
  </div>
</aside>

<main class="main">
<header class="topbar">
  <div>
    <b id="pageTitle">Dashboard</b>
    <div class="muted small">Creative • Learning • Simulation</div>
  </div>
  <input class="search" id="globalSearch" placeholder="Search tools, notes, games...">
</header>

<!-- DASHBOARD -->
<section class="page active" id="home">
  <h1>Welcome to <span style="color:var(--cyan)">EditVerse</span> ⚡</h1>
  <p class="subtitle">Your all-in-one creative and study workspace.</p>

  <div class="grid">
    <div class="card"><span class="muted">Editing Projects</span><div class="stat" id="projectCount">0</div><span class="tag">Browser</span></div>
    <div class="card"><span class="muted">Virtual Balance</span><div class="stat" id="dashBalance">₹100,000</div><span class="tag">Demo only</span></div>
    <div class="card"><span class="muted">Study Subjects</span><div class="stat">6</div><span class="tag">Class 11</span></div>
    <div class="card"><span class="muted">Mini Games</span><div class="stat">5</div><span class="tag">Play</span></div>
  </div>

  <div style="height:15px"></div>
  <div class="grid">
    <div class="card">
      <h2>🎬 Editing Studio</h2><p class="muted" style="margin:8px 0 15px">Create videos with a CapCut-inspired workflow.</p>
      <button class="neon-btn primary" onclick="showPage('editor')">Open Editor →</button>
    </div>
    <div class="card">
      <h2>📈 Trading Simulator</h2><p class="muted" style="margin:8px 0 15px">Practice buying and selling with virtual money.</p>
      <button class="neon-btn" onclick="showPage('trading')">Start Practice →</button>
    </div>
    <div class="card">
      <h2>📚 Detailed Notes</h2><p class="muted" style="margin:8px 0 15px">Class 11 notes across six subjects.</p>
      <button class="neon-btn" onclick="showPage('notes')">Study Now →</button>
    </div>
  </div>
</section>

<!-- EDITOR -->
<section class="page" id="editor">
  <h1>🎬 Editing Studio</h1>
  <p class="subtitle">Browser video/photo editor — import media and build your timeline.</p>

  <div class="editor">
    <div class="editor-toolbar">
      <button class="tool-btn" onclick="document.getElementById('mediaInput').click()">📁 Import</button>
      <input type="file" id="mediaInput" accept="video/*,image/*" multiple hidden>
      <button class="tool-btn" onclick="addText()">T Text</button>
      <button class="tool-btn" onclick="splitClip()">✂ Split</button>
      <button class="tool-btn" onclick="deleteClip()">🗑 Delete</button>
      <button class="tool-btn" onclick="setSpeed(.5)">0.5×</button>
      <button class="tool-btn" onclick="setSpeed(1)">1×</button>
      <button class="tool-btn" onclick="setSpeed(2)">2×</button>
      <button class="tool-btn" onclick="toggleFilter()">🎨 Filter</button>
      <button class="tool-btn" onclick="setRatio('16:9')">16:9</button>
      <button class="tool-btn" onclick="setRatio('9:16')">9:16</button>
      <button class="tool-btn" onclick="setRatio('1:1')">1:1</button>
      <button class="tool-btn primary" onclick="exportProject()">⬇ Export</button>
    </div>

    <div class="editor-workspace">
      <div class="media-panel">
        <h3>MEDIA</h3>
        <div class="media-item" onclick="document.getElementById('mediaInput').click()">＋ Add Media</div>
        <div id="mediaList"></div>
        <h3 style="margin-top:18px">ELEMENTS</h3>
        <div class="media-item" onclick="addText()">T Text</div>
        <div class="media-item" onclick="toggleFilter()">✨ Effects</div>
        <div class="media-item" onclick="toast('Audio track ready')">🎵 Audio</div>
      </div>

      <div class="canvas-area">
        <div class="canvas" id="previewCanvas">
          <div class="placeholder" id="placeholder">Import a video or image<br><small>Preview appears here</small></div>
          <video id="previewVideo" controls style="display:none"></video>
          <img id="previewImage" style="display:none">
          <div class="canvas-text" id="canvasText">Your Text</div>
        </div>
      </div>

      <div class="properties">
        <h3>PROPERTIES</h3>
        <div class="prop">
          <label>TEXT</label>
          <input id="textInput" value="Your Text" oninput="updateText()">
        </div>
        <div class="prop">
          <label>TEXT SIZE</label>
          <input type="range" min="12" max="90" value="32" id="textSize" oninput="updateText()">
        </div>
        <div class="prop">
          <label>OPACITY</label>
          <input type="range" min="0" max="100" value="100" id="opacity" oninput="updateOpacity()">
        </div>
        <div class="prop">
          <label>BRIGHTNESS</label>
          <input type="range" min="50" max="150" value="100" id="brightness" oninput="updateFilter()">
        </div>
        <div class="prop">
          <label>CONTRAST</label>
          <input type="range" min="50" max="150" value="100" id="contrast" oninput="updateFilter()">
        </div>
        <div class="prop">
          <label>SATURATION</label>
          <input type="range" min="0" max="200" value="100" id="saturation" oninput="updateFilter()">
        </div>
      </div>
    </div>

    <div class="timeline">
      <div class="row" style="justify-content:space-between;margin-bottom:8px">
        <span class="muted small">TIMELINE</span>
        <span class="muted small" id="timeLabel">00:00 / 00:00</span>
      </div>
      <div class="track" id="videoTrack">
        <span class="track-title">VIDEO</span>
        <div class="playhead" id="playhead"></div>
      </div>
      <div class="track">
        <span class="track-title">TEXT</span>
        <div class="clip" style="left:10%;width:25%">Text Layer</div>
      </div>
      <div class="track">
        <span class="track-title">AUDIO</span>
      </div>
    </div>
  </div>
</section>

<!-- TRADING -->
<section class="page" id="trading">
  <h1>📈 Demo Trading Simulator</h1>
  <p class="subtitle">Practice trading with virtual money. No real transactions.</p>

  <div class="grid" style="margin-bottom:15px">
    <div class="card"><span class="muted">Virtual Cash</span><div class="balance" id="balance">₹100,000</div></div>
    <div class="card"><span class="muted">Portfolio Value</span><div class="balance" id="portfolioValue">₹100,000</div></div>
    <div class="card"><span class="muted">P&L</span><div class="balance" id="pnl">₹0</div></div>
  </div>

  <div class="trading-grid">
    <div>
      <div class="market">
        <div class="section-head">
          <div><b id="stockName">NEON TECH</b> <span class="tag">SIM</span></div>
          <div><b id="price">₹250.00</b></div>
        </div>
        <canvas id="tradingChart" class="chart"></canvas>
      </div>
      <div class="card" style="margin-top:15px">
        <div class="section-head"><h3>Portfolio</h3><span class="muted small">Virtual positions</span></div>
        <div id="portfolioList" class="muted">No positions yet.</div>
      </div>
    </div>

    <div class="card trade-box">
      <h3 style="margin-bottom:15px">Trade Panel</h3>
      <select id="tradeSymbol">
        <option value="NEON">NEON TECH</option>
        <option value="PIXEL">PIXEL MOTORS</option>
        <option value="CYBER">CYBER ENERGY</option>
      </select>
      <input type="number" id="tradeQty" value="1" min="1" placeholder="Quantity">
      <div class="row">
        <button class="neon-btn buy" style="flex:1" onclick="trade('buy')">BUY</button>
        <button class="neon-btn sell" style="flex:1" onclick="trade('sell')">SELL</button>
      </div>
      <p class="muted small" style="margin-top:15px">Prices move automatically for simulation.</p>
    </div>
  </div>

  <div class="card" style="margin-top:15px">
    <h3 style="margin-bottom:10px">Trade History</h3>
    <table><thead><tr><th>Time</th><th>Action</th><th>Asset</th><th>Qty</th><th>Price</th><th>Total</th></tr></thead>
    <tbody id="tradeHistory"><tr><td colspan="6" class="muted">No trades yet.</td></tr></tbody></table>
  </div>
</section>

<!-- TOOLS -->
<section class="page" id="tools">
  <h1>🧰 Tools</h1>
  <p class="subtitle">Useful everyday utilities built directly into EditVerse.</p>

  <div class="grid">
    <div class="card tool-card">
      <h3>🧮 Calculator</h3>
      <input id="calc" placeholder="Example: 25*4+10">
      <button class="neon-btn primary" onclick="calculate()">Calculate</button>
      <p id="calcResult" class="stat" style="font-size:20px"></p>
    </div>

    <div class="card tool-card">
      <h3>📊 Percentage</h3>
      <input id="p1" type="number" placeholder="Value">
      <input id="p2" type="number" placeholder="Total">
      <button class="neon-btn" onclick="percentage()">Find %</button>
      <p id="pResult" class="stat" style="font-size:20px"></p>
    </div>

    <div class="card tool-card">
      <h3>🔄 Unit Converter</h3>
      <input id="unitVal" type="number" value="1">
      <select id="unitType"><option value="kmmi">KM → Miles</option><option value="mft">Meters → Feet</option><option value="kgp">KG → Pounds</option><option value="cm">CM → Inches</option></select>
      <button class="neon-btn" onclick="convertUnit()">Convert</button>
      <p id="unitResult" class="stat" style="font-size:20px"></p>
    </div>

    <div class="card tool-card">
      <h3>🎂 Age Calculator</h3>
      <input id="birthDate" type="date">
      <button class="neon-btn" onclick="ageCalc()">Calculate Age</button>
      <p id="ageResult" class="stat" style="font-size:20px"></p>
    </div>

    <div class="card tool-card">
      <h3>⚖️ BMI Calculator</h3>
      <input id="height" type="number" placeholder="Height cm">
      <input id="weight" type="number" placeholder="Weight kg">
      <button class="neon-btn" onclick="bmiCalc()">Calculate BMI</button>
      <p id="bmiResult" class="stat" style="font-size:20px"></p>
    </div>

    <div class="card tool-card">
      <h3>🔐 Password Generator</h3>
      <input id="passLen" type="number" value="16" min="4" max="64">
      <button class="neon-btn" onclick="generatePassword()">Generate</button>
      <input id="passwordResult" readonly>
    </div>

    <div class="card tool-card">
      <h3>📝 Text Counter</h3>
      <textarea id="counterText" rows="3" placeholder="Type text..." oninput="countText()"></textarea>
      <p id="countResult" class="muted">0 characters • 0 words</p>
    </div>

    <div class="card tool-card">
      <h3>⏱️ Stopwatch</h3>
      <div class="stat" id="stopwatch">00:00:00</div>
      <div class="row"><button class="neon-btn" onclick="startStopwatch()">Start</button><button class="neon-btn" onclick="stopStopwatch()">Stop</button><button class="neon-btn" onclick="resetStopwatch()">Reset</button></div>
    </div>

    <div class="card tool-card">
      <h3>⏲️ Timer</h3>
      <input id="timerInput" type="number" placeholder="Seconds">
      <button class="neon-btn" onclick="startTimer()">Start Timer</button>
      <div class="stat" id="timerDisplay" style="font-size:20px">00:00</div>
    </div>

    <div class="card tool-card">
      <h3>📐 Quick Notes</h3>
      <textarea id="quickNotes" rows="4" placeholder="Write something..."></textarea>
      <button class="neon-btn" onclick="saveQuickNotes()">Save</button>
    </div>

