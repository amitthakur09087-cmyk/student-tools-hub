}
navButtons.forEach(b=>b.onclick=()=>showPage(b.dataset.page));

function toast(msg){
  const t=document.getElementById("toast");
  t.textContent=msg;t.classList.add("show");
  clearTimeout(window.toastTimer);
  window.toastTimer=setTimeout(()=>t.classList.remove("show"),2200);
}
document.getElementById("globalSearch").addEventListener("input",e=>{
  const q=e.target.value.toLowerCase().trim();
  if(!q)return;
  if(q.includes("edit"))showPage("editor");
  else if(q.includes("trade"))showPage("trading");
  else if(q.includes("game"))showPage("games");
  else if(q.includes("note")||q.includes("study"))showPage("notes");
  else if(q.includes("tool"))showPage("tools");
});

/* =========================
   EDITOR
========================= */
let currentMedia=null;
let clips=[];
let editorFilter=false;

const mediaInput=document.getElementById("mediaInput");
mediaInput.addEventListener("change",e=>{
  [...e.target.files].forEach(file=>{
    const url=URL.createObjectURL(file);
    clips.push({name:file.name,url,type:file.type});
    addMediaItem(file,url);
    if(!currentMedia)loadMedia(file,url);
  });
  document.getElementById("projectCount").textContent=clips.length;
});

function addMediaItem(file,url){
  const div=document.createElement("div");
  div.className="media-item";
  div.textContent="🎞 "+file.name.slice(0,20);
  div.onclick=()=>loadMedia(file,url);
  document.getElementById("mediaList").appendChild(div);

  const track=document.getElementById("videoTrack");
  const clip=document.createElement("div");
  clip.className="clip";
  clip.style.left=(10+Math.min(70,clips.length*8))+"%";
  clip.style.width="18%";
  clip.textContent=file.name.slice(0,18);
  track.appendChild(clip);
}
function loadMedia(file,url){
  currentMedia={file,url};
  const v=document.getElementById("previewVideo");
  const img=document.getElementById("previewImage");
  const ph=document.getElementById("placeholder");
  ph.style.display="none";
  if(file.type.startsWith("video/")){
    img.style.display="none";v.style.display="block";v.src=url;
    v.playbackRate=1;
    v.onloadedmetadata=()=>updateTime();
    v.ontimeupdate=updateTime;
  }else{
    v.pause();v.style.display="none";img.style.display="block";img.src=url;
  }
  toast("Media loaded");
}
function updateTime(){
  const v=document.getElementById("previewVideo");
  const f=n=>String(Math.floor(n||0)/60|0).padStart(2,"0")+":"+String(Math.floor(n||0)%60).padStart(2,"0");
  document.getElementById("timeLabel").textContent=f(v.currentTime)+" / "+f(v.duration);
  if(v.duration)document.getElementById("playhead").style.left=(v.currentTime/v.duration*100)+"%";
}
function addText(){
  const t=document.getElementById("canvasText");
  t.style.display="block";updateText();toast("Text layer added");
}
function updateText(){
  const t=document.getElementById("canvasText");
  t.textContent=document.getElementById("textInput").value;
  t.style.fontSize=document.getElementById("textSize").value+"px";
}
function updateOpacity(){
  document.getElementById("canvasText").style.opacity=document.getElementById("opacity").value/100;
}
function updateFilter(){
  const b=document.getElementById("brightness").value;
  const c=document.getElementById("contrast").value;
  const s=document.getElementById("saturation").value;
  const f=`brightness(${b}%) contrast(${c}%) saturate(${s}%)`;
  document.getElementById("previewVideo").style.filter=f;
  document.getElementById("previewImage").style.filter=f;
}
function toggleFilter(){
  editorFilter=!editorFilter;
  if(editorFilter){
    document.getElementById("brightness").value=115;
    document.getElementById("contrast").value=115;
    document.getElementById("saturation").value=135;
  }else{
    document.getElementById("brightness").value=100;
    document.getElementById("contrast").value=100;
    document.getElementById("saturation").value=100;
  }
  updateFilter();toast(editorFilter?"Cinematic filter ON":"Filter OFF");
}
function setSpeed(speed){
  const v=document.getElementById("previewVideo");
  v.playbackRate=speed;
  toast("Playback speed: "+speed+"×");
}
function setRatio(r){
  const c=document.getElementById("previewCanvas");
  c.classList.remove("vertical","square");
  if(r==="9:16")c.classList.add("vertical");
  if(r==="1:1")c.classList.add("square");
