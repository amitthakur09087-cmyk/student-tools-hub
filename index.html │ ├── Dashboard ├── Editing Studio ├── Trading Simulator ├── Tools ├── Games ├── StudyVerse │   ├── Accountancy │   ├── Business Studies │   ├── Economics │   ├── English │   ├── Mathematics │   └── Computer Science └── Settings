/* CAR */
let carRunning=false,carX=230,carObs=[],carScore=0,carRAF;
function startCarGame(){
  cancelAnimationFrame(carRAF);carRunning=true;carX=230;carObs=[];carScore=0;carLoop();
}
function carLoop(){
  const c=document.getElementById("carGame"),x=c.getContext("2d");
  x.clearRect(0,0,c.width,c.height);
  x.fillStyle="#06070a";x.fillRect(0,0,c.width,c.height);
  x.strokeStyle="#222a34";x.lineWidth=3;
  for(let i=0;i<6;i++){x.beginPath();x.moveTo(160+i*70,0);x.lineTo(160+i*70,c.height);x.stroke()}
  if(keys.ArrowLeft)carX-=5;if(keys.ArrowRight)carX+=5;
  carX=Math.max(165,Math.min(335,carX));
  if(Math.random()<.025)carObs.push({x:165+Math.random()*170,y:-30});
  carObs.forEach(o=>o.y+=4+carScore/700);
  carObs=carObs.filter(o=>o.y<280);
  x.fillStyle="#00eaff";x.fillRect(carX,205,35,55);
  x.fillStyle="#ff00a8";x.fillRect(carX+7,213,21,15);
  carObs.forEach(o=>{x.fillStyle="#ff315f";x.fillRect(o.x,o.y,35,45)});
  carObs.forEach(o=>{if(o.x<carX+35&&o.x+35>carX&&o.y<260&&o.y+45>205){carRunning=false;toast("Car crash! Score "+carScore)}})
  x.fillStyle="white";x.font="16px Arial";x.fillText("Score: "+carScore,15,25);
  carScore++;
  if(carRunning)carRAF=requestAnimationFrame(carLoop);
}

/* AIRSHIP */
let airRunning=false,airY=120,airObs=[],airScore=0,airRAF;
function startAirGame(){cancelAnimationFrame(airRAF);airRunning=true;airY=120;airObs=[];airScore=0;airLoop()}
function airLoop(){
  const c=document.getElementById("airGame"),x=c.getContext("2d");
  x.clearRect(0,0,c.width,c.height);x.fillStyle="#020912";x.fillRect(0,0,c.width,c.height);
  if(keys.ArrowUp)airY-=4;if(keys.ArrowDown)airY+=4;airY=Math.max(20,Math.min(200,airY));
  if(Math.random()<.035)airObs.push({x:500,y:Math.random()*210,w:25});
  airObs.forEach(o=>o.x-=4);airObs=airObs.filter(o=>o.x>-40);
  x.fillStyle="#8b5cff";x.beginPath();x.arc(90,airY,18,0,Math.PI*2);x.fill();
  airObs.forEach(o=>{x.fillStyle="#ff00a8";x.fillRect(o.x,o.y,25,50)});
  airObs.forEach(o=>{if(o.x<110&&o.x+25>70&&airY+18>o.y&&airY-18<o.y+50){airRunning=false;toast("Airship hit! Score "+airScore)}})
  x.fillStyle="white";x.font="16px Arial";x.fillText("Score: "+airScore,15,25);airScore++;
  if(airRunning)airRAF=requestAnimationFrame(airLoop);
}

/* SHOOTER */
let shootRunning=false,targets=[],shootScore=0,shootTimer;
function startShootGame(){
  const c=document.getElementById("shootGame");
  shootRunning=true;shootScore=0;targets=[];clearInterval(shootTimer);
  shootTimer=setInterval(()=>{
    if(!shootRunning)return;
    targets.push({x:30+Math.random()*440,y:35+Math.random()*180,r:18,life:0});
    targets=targets.filter(t=>++t.life<50);
    drawShooter();
  },650);drawShooter();
  c.onclick=e=>{
    if(!shootRunning)return;
    const r=c.getBoundingClientRect(),mx=(e.clientX-r.left)*c.width/r.width,my=(e.clientY-r.top)*c.height/r.height;
    targets=targets.filter(t=>{
      if(Math.hypot(t.x-mx,t.y-my)<t.r){shootScore++;return false}return true;
    });drawShooter();
  };
}
function drawShooter(){
  const c=document.getElementById("shootGame"),x=c.getContext("2d");
  x.fillStyle="#050609";x.fillRect(0,0,c.width,c.height);
  targets.forEach(t=>{x.fillStyle="#ff315f";x.beginPath();x.arc(t.x,t.y,t.r,0,Math.PI*2);x.fill();x.fillStyle="white";x.beginPath();x.arc(t.x,t.y,6,0,Math.PI*2);x.fill()});
  x.fillStyle="white";x.font="16px Arial";x.fillText("Score: "+shootScore,15,25);
}

/* SNAKE */
let snakeRunning=false,snake=[],food={},dir={x:1,y:0},snakeRAF,snakeScore=0;
function startSnake(){
  snakeRunning=true;snake=[{x:10,y:5},{x:9,y:5},{x:8,y:5}];dir={x:1,y:0};snakeScore=0;placeFood();snakeLoop();
}
function placeFood(){food={x:Math.floor(Math.random()*24),y:Math.floor(Math.random()*11)}}
window.addEventListener("keydown",e=>{
  if(e.key==="ArrowUp"&&dir.y!==1)dir={x:0,y:-1};
  if(e.key==="ArrowDown"&&dir.y!==-1)dir={x:0,y:1};
  if(e.key==="ArrowLeft"&&dir.x!==1)dir={x:-1,y:0};
  if(e.key==="ArrowRight"&&dir.x!==-1)dir={x:1,y:0};
});
function snakeLoop(){
  if(!snakeRunning)return;
  const head={x:snake[0].x+dir.x,y:snake[0].y+dir.y};
  if(head.x<0||head.x>=25||head.y<0||head.y>=12||snake.some(s=>s.x===head.x&&s.y===head.y)){snakeRunning=false;toast("Snake game over: "+snakeScore);return}
  snake.unshift(head);
  if(head.x===food.x&&head.y===food.y){snakeScore++;placeFood()}else snake.pop();
  const c=document.getElementById("snakeGame"),x=c.getContext("2d");
  x.fillStyle="#030507";x.fillRect(0,0,c.width,c.height);
  snake.forEach(s=>{x.fillStyle="#00ff88";x.fillRect(s.x*20,s.y*20,18,18)});
  x.fillStyle="#ff00a8";x.fillRect(food.x*20,food.y*20,18,18);
  x.fillStyle="white";x.fillText("Score: "+snakeScore,15,240);
  snakeRAF=setTimeout(snakeLoop,100);
}

/* BRICK BREAKER */
let brickRAF,brickRunning=false,bx=245,ball={x:250,y:210,vx:3,vy:-3},bricks=[];
function startBrick(){
  cancelAnimationFrame(brickRAF);brickRunning=true;bx=215;ball={x:250,y:210,vx:3,vy:-3};bricks=[];
  for(let r=0;r<4;r++)for(let col=0;col<10;col++)bricks.push({x:col*48+10,y:r*25+15,on:true});
  brickLoop();
}
function brickLoop(){
  if(!brickRunning)return;
  const c=document.getElementById("brickGame"),x=c.getContext("2d");
  if(keys.ArrowLeft)bx-=6;if(keys.ArrowRight)bx+=6;bx=Math.max(0,Math.min(430,bx));
  ball.x+=ball.vx;ball.y+=ball.vy;
  if(ball.x<5||ball.x>495)ball.vx*=-1;
  if(ball.y<5)ball.vy*=-1;
  if(ball.y>230){brickRunning=false;toast("Game over");return}
  if(ball.y>225&&ball.y<240&&ball.x>bx&&ball.x<bx+70)ball.vy=-Math.abs(ball.vy);
  bricks.forEach(b=>{
    if(b.on&&ball.x>b.x&&ball.x<b.x+42&&ball.y>b.y&&ball.y<b.y+18){b.on=false;ball.vy*=-1}
  });
  x.fillStyle="#030507";x.fillRect(0,0,500,250);
  bricks.forEach(b=>{if(b.on){x.fillStyle="#8b5cff";x.fillRect(b.x,b.y,42,18)}});
  x.fillStyle="#00eaff";x.fillRect(bx,230,70,10);
  x.fillStyle="#fff";x.beginPath();x.arc(ball.x,ball.y,6,0,Math.PI*2);x.fill();
  if(bricks.every(b=>!b.on)){brickRunning=false;toast("You won! 🎉");return}
  brickRAF=requestAnimationFrame(brickLoop);
}

