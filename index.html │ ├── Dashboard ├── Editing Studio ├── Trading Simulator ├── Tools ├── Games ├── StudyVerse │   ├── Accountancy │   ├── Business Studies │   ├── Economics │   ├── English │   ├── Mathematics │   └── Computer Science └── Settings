}
function splitClip(){toast("Clip split at current playhead");}
function deleteClip(){
  if(clips.length){
    clips.pop();
    const list=document.getElementById("mediaList");
    if(list.lastChild)list.removeChild(list.lastChild);
    document.getElementById("projectCount").textContent=clips.length;
    toast("Last imported clip removed");
